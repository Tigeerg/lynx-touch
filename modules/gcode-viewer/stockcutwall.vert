// stockcutwall.vert - стенка точного контура реза: позиции уже в машинных мм
// (буфер ядра core/stock_sim, stockCutWall), верх на плоскости нетронутого верха
// (zMaxMm), низ на дне реза в точке контура.
//
// Своей нормали у буфера нет: у ядра в вершине позиция и глубина дна, а
// направление отрезков контура разное. Поэтому светлота - ровная доля stockTone
// (та же лампа слитка, что у верха поля и оболочки, stocksurface.vert и
// stockshell.vert): стенка читается снятым металлом, темнее дна кармана. Нормаль
// во фрагменте (этап 1.1 плана) сюда не доходит - стенка от неё не зависит.
//
// Сдвиг глубины к глазу (depthOffset) - то же правило, что у верха поля и
// оболочки: стенка стоит в плоскости нетронутого верха, где с ней спорит
// нарисованный верх за один пиксель. Сдвигается только clip z, позиции вершин не
// двигаются - габарит заготовки и глубина реза остаются точными.
VARYING float vShade;

void MAIN()
{
    vShade = stockTone + (1.0 - stockTone) * 0.55;
    POSITION = MODELVIEWPROJECTION_MATRIX * vec4(VERTEX, 1.0);
    POSITION.z += depthOffset * POSITION.w;
}
