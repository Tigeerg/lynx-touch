// stockshell.vert - стенки и дно заготовки: нормаль грани из положения вершины.
//
// Зачем нормаль здесь, а не в буфере: оболочку строит ядро (core/stock_sim,
// stockShellVertices) буфером из одних позиций, и ровно этот буфер сверяет
// случай stockshell пробника (30 вершин по три числа) - менять его нельзя.
// Пятигранник осевой (стенки - габарит плюс зазоры, верхней грани нет: её рисует
// поле), поэтому грань, на которой стоит вершина, видна по тому, какая координата
// легла на свою границу: наружная нормаль - знак этой оси. Границы стенок
// приходят свойствами QML (shellCenter, shellHalf в машинных мм) - теми же
// числами, из которых собрана геометрия.
//
// Светлота - та же, что у верха поля (stocksurface.vert, свойства stockTone и
// stockLamp): слиток читается одним телом, а не наклейкой одного цвета. Прежде
// оболочка шла без света (у неё нет атрибута нормали) и все стенки были залиты
// одним #B79A55 - отсюда и жалоба на странный цвет боковых граней.
//
// Машинные координаты вершины едут во фрагмент (vMachine): там по ним берётся
// глубина поля и обрезается верх стенки - разбор в stockshell.frag. Позиции
// оболочки и так в машинных мм (буфер ядра), поэтому VERTEX до поворота узла.
VARYING float vShade;
VARYING vec3 vMachine;

void MAIN()
{
    vec3 rel = (VERTEX - shellCenter) / max(shellHalf, vec3(1e-6));
    vec3 a = abs(rel);
    vec3 normal = (a.x >= a.y && a.x >= a.z) ? vec3(sign(rel.x), 0.0, 0.0)
                : (a.y >= a.z)               ? vec3(0.0, sign(rel.y), 0.0)
                                             : vec3(0.0, 0.0, sign(rel.z));
    vShade = stockTone + (1.0 - stockTone) * max(0.0, dot(normal, normalize(stockLamp)));
    vMachine = VERTEX;
    // POSITION пишется явно: у незатенённого материала своего расчёта POSITION
    // нет (в отличие от затенённого), и без этой строки вершины уезжают в ноль.
    POSITION = MODELVIEWPROJECTION_MATRIX * vec4(VERTEX, 1.0);
}
