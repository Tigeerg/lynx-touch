// stocksurface.frag - цвет поверхности остатка заготовки.
//
// Материал затенённый (CustomMaterial.Shaded), поэтому здесь задаётся только
// цвет материала, а свет сцены считает движок - так же, как для кожи детали
// (PrincipledMaterial): DirectionalLight'ы вьювера и тонкая заливка тёплым
// ambient дают резаной стенке тень, по которой глубина и читается. Цвет
// приходит свойством QML (CustomMaterial переводит color в линейное
// пространство, как PrincipledMaterial.baseColor).
//
// Нормаль уже посчитана вершинным шейдером (NORMAL) и в кадре сцены её
// разворачивает движок: здесь трогать нечего.
void MAIN()
{
    BASE_COLOR = vec4(stockColor.rgb, 1.0);
}
