// stocksurface.frag - цвет поверхности остатка заготовки по глубине съёма.
//
// Задача вида - читаемость, а не физически нейтральный серый: оператор должен
// одним взглядом видеть, где металл ещё не тронут, а где снят. Поэтому цвет
// двухцветный с резкой границей по глубине: необработанный верх (глубина ровно
// 0) - тёплая охра #C3A45E, снятый металл - медь #C9571A. Оба тона тёплые и
// далеки по светлоте от холодной серой кожи детали (#B9BEC4), а с цветами
// траектории (зелёный #1D9247 быстрый ход, синий #0362BB рабочий) не спорят по
// тону. Цвета - пресеты вьювера (GcodeViewer3D.qml, клавиша C): пресет задаёт
// оба цвета сразу, а CNC_STOCK_RAW/CNC_STOCK_CUT ставят их до старта.
//
// Шкала по глубине (градиент) отвергнута нарочно: поле квантовано узлом 0.5 мм
// и читается выборкой nearest, поэтому градиент дал бы полосы на каждой ступени
// поля - это читалось бы как шум поля, а не как глубина, и требовало бы легенды
// на экране. Двухцветная граница отвечает на вопрос "где уже снято" сразу.
// Глубину самой стенки реза читает светлота: её считает вершинный шейдер от
// нормали (stocksurface.vert, свойства stockTone/stockLamp), а не свет сцены -
// разбор в его комментарии: свет сцены давал дну кармана светлоту меньше стенки,
// и карман читался конусом. Цвета приходят свойствами QML (CustomMaterial
// переводит color в линейное пространство, как PrincipledMaterial.baseColor),
// поэтому здесь результат умножается на светлоту в линейном пространстве и
// кодируется назад в sRGB - так же, как это делают линии УП (toolpath.frag).
//
// Глубина - из того же поля, что и высота вершин (core/stock_sim, depthMm):
// глубина ОТ верха заготовки, 0 - не тронуто, больше 0 - снято. Порог cutMm
// отсекает задиры на десятые доли узла: 0.05 мм - на порядок ниже узла 0.5 мм
// и вдвое ниже подачи на зуб.
//
// Выборка идёт по uv, пришедшему из вершинного шейдера (VARYING vUv): у
// незатенённого материала встроенного UV0 во фрагменте нет, поэтому тот же
// texcoord едет своим VARYING. Значение то же (интерполированный texcoord
// вершины), поэтому граница снято/не снято идёт по тем же текселям, что и была.
VARYING vec2 vUv;
VARYING float vShade;

vec3 linearToSrgb(vec3 c)
{
    return mix(c * 12.92,
               1.055 * pow(c, vec3(0.4166667)) - 0.055,
               step(vec3(0.0031308), c));
}

void MAIN()
{
    float depth = texture(stockField, vUv).r;
    vec3 color = (depth > cutMm ? stockCutColor.rgb : stockRawColor.rgb) * vShade;
    FRAGCOLOR = vec4(linearToSrgb(color), 1.0);
}
